// =============================================================
// Nots.ai — Prisma Schema v1.1
// Database: Neon (PostgreSQL) + pgvector
// ORM: Prisma with preview feature for PG extensions
//
// CHANGELOG v1.1:
// - SourceEvent → NodalTask is now MANY-TO-MANY via TaskSourceLink.
//   One message can contribute to multiple tasks (e.g., a Slack msg
//   referencing two separate objectives).
// - Standardized on Gemini text-embedding-004 (768d). OpenAI
//   text-embedding-3-small (1536d) is NOT used. If you switch
//   providers, you must re-embed all existing tasks.
// - TaskSourceLink carries relevanceScore so the HITL queue can
//   surface ambiguous multi-task assignments for human review.
// =============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector", schema: "public")]
}

// =============================================================
// ENUMS
// =============================================================

enum Platform {
  SLACK
  GMAIL
  JIRA
  TRELLO
  ASANA
  MANUAL
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  DONE
  ARCHIVED
}

// =============================================================
// USER
// Stores identity + encrypted OAuth tokens per integration.
// Token encryption (AES-256) happens at the application layer,
// NOT in Prisma. These fields hold ciphertext only.
// =============================================================

model User {
  id    String  @id @default(cuid())
  email String  @unique
  name  String?

  // Encrypted OAuth tokens — AES-256 at app layer
  slackTokenEnc String? @map("slack_token_enc")
  gmailTokenEnc String? @map("gmail_token_enc")
  jiraTokenEnc  String? @map("jira_token_enc")

  // User-configurable settings (noise keywords, priority rules, etc.)
  preferences Json? @db.JsonB

  nodalTasks NodalTask[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// =============================================================
// NODAL TASK
// The core "refined signal" entity. Each NodalTask represents a
// single objective constructed from messages across platforms.
//
// embedding: 768-dim vector from Gemini text-embedding-004.
//            DO NOT mix with OpenAI embeddings — cosine similarity
//            across different model families is meaningless.
//
// needsReview: Flips to true when:
//   - Orchestrator confidence < 0.70, OR
//   - A SourceEvent links to multiple tasks with close scores
//     (ambiguous assignment detected by TaskSourceLink).
// =============================================================

model NodalTask {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String // "Smart Title" generated by Refiner agent
  intent   String? // Intent classification tag
  priority Priority   @default(MEDIUM)
  status   TaskStatus @default(OPEN)

  // Semantic vector — default: Gemini text-embedding-004 (768d)
  // Used for the 0.85 cosine similarity threshold grouping.
  //
  // MODEL SWITCHING: If you change embedding providers, you MUST
  // re-embed every existing task. Cosine similarity across different
  // model families is meaningless. The embeddingModel field tracks
  // which model generated this vector so stale embeddings are
  // detectable and re-processable during migration.
  embedding      Unsupported("vector(768)")?
  embeddingModel String                      @default("gemini-embedding-001") @map("embedding_model")

  // Orchestrator confidence score (0.0 – 1.0)
  confidence  Float   @default(0)
  needsReview Boolean @default(false) @map("needs_review")

  // Visual emphasis tier within kanban columns (1 = gold, 2 = silver, 3 = bronze)
  tier           Int              @default(0)
  bookmarked     Boolean          @default(false)
  seenEventCount Int              @default(0) @map("seen_event_count")
  // MANY-TO-MANY: A task can have many source events,
  // and a source event can belong to many tasks.
  sourceLinks    TaskSourceLink[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([needsReview])
  @@map("nodal_tasks")
}

// =============================================================
// TASK SOURCE LINK (Join Table)
// Bridges NodalTask ↔ SourceEvent as many-to-many.
//
// WHY THIS EXISTS:
// A single Slack message like "Budget deck needs review and the
// onboarding doc is ready" maps to TWO separate Nodal Tasks.
// A strict FK on SourceEvent forced it into one — losing signal.
//
// relevanceScore: The cosine similarity score (0.0–1.0) between
//   the SourceEvent's content and the NodalTask's embedding at
//   the time of assignment. This is NOT the task's overall
//   confidence — it's the per-link match strength.
//
// HITL TRIGGER: If a SourceEvent has 2+ links where the spread
//   between scores is < 0.05 (e.g., 0.87 and 0.89), flag both
//   tasks for human review — the assignment is ambiguous.
// =============================================================

model TaskSourceLink {
  id      String      @id @default(cuid())
  taskId  String      @map("task_id")
  task    NodalTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  eventId String      @map("event_id")
  event   SourceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Cosine similarity at time of assignment
  relevanceScore Float @map("relevance_score")

  // Was this link manually confirmed or overridden by a human?
  humanVerified Boolean @default(false) @map("human_verified")

  // SOFT DELETE: When a human dismisses a link during HITL review,
  // we keep the row for audit trail instead of hard deleting.
  // All queries MUST filter on dismissed = false to exclude these.
  dismissed   Boolean   @default(false)
  dismissedAt DateTime? @map("dismissed_at")
  dismissedBy String?   @map("dismissed_by") // userId of the reviewer

  createdAt DateTime @default(now()) @map("created_at")

  // Prevent duplicate links: same event can't link to same task twice
  @@unique([taskId, eventId])
  @@index([taskId])
  @@index([eventId])
  @@index([relevanceScore])
  @@index([dismissed])
  @@map("task_source_links")
}

//   @@index([threadId])
//   @@index([channelId])
//
// Then run in Neon SQL Editor:
//   ALTER TABLE source_events ADD COLUMN thread_id TEXT;
//   ALTER TABLE source_events ADD COLUMN channel_id TEXT;
//   CREATE INDEX idx_source_events_thread_id ON source_events (thread_id);
//   CREATE INDEX idx_source_events_channel_id ON source_events (channel_id);
// =============================================================
// SOURCE EVENT (The Provenance Ledger)
// Immutable log entry. Each row = one message/notification from
// a connected platform that was refined into parent NodalTask(s).
//
// sourceHash: SHA-256 of (platform + deepLink + rawContent).
//             Unique constraint = idempotency guard.
//
// deepLink: Platform-native URI for one-click verification.
//   Slack:  slack://channel?team=T123&id=C456&message=1234567890.123456
//   Gmail:  https://mail.google.com/mail/u/0/#inbox/<threadId>
//   Jira:   https://<domain>.atlassian.net/browse/PROJ-123
// =============================================================

model SourceEvent {
  id String @id @default(cuid())

  platform   Platform
  rawContent String   @map("raw_content") // Text snippet — NOT full email body (data minimization)
  deepLink   String   @map("deep_link")
  sender     String?
  threadId   String?  @map("thread_id")
  channelId  String?  @map("channel_id")

  //
  //   // Thread/conversation identifier for deterministic merge (Stage 1)
  //   // Slack: thread_ts value (parent message timestamp, shared by all replies)
  //   // Gmail: Gmail threadId (all emails in a conversation share this)
  //   threadId   String?  @map("thread_id")
  //
  //   // Channel/context identifier for sender+time heuristic (Stage 2)
  //   // Slack: channel ID (e.g. C0ADGL60FGE)
  //   // Gmail: not used (threadId is sufficient)
  //   channelId  String?  @map("channel_id")
  // Idempotency key — prevents reprocessing identical messages
  sourceHash String @unique @map("source_hash")

  // Refiner-extracted metadata (links, dates, mentioned users, etc.)
  metadata Json? @db.JsonB

  attachments Attachment[]

  // MANY-TO-MANY: This event can be linked to multiple tasks
  taskLinks TaskSourceLink[]

  // Timestamp of the ORIGINAL message, not when we ingested it
  timestamp DateTime
  createdAt DateTime @default(now()) @map("created_at")

  @@index([sourceHash])
  @@index([platform])
  @@index([timestamp])
  @@index([threadId])
  @@index([channelId])
  @@map("source_events")
}

// =============================================================
// ATTACHMENT
// Metadata-only. Actual files stay on the source platform.
// We store the URL so the UI can render previews/download links.
// =============================================================

model Attachment {
  id      String      @id @default(cuid())
  eventId String      @map("event_id")
  event   SourceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name     String
  url      String
  mimeType String? @map("mime_type")
  size     Int? // bytes

  createdAt DateTime @default(now()) @map("created_at")

  @@index([eventId])
  @@map("attachments")
}

// =============================================================
// MANUAL SQL (run after prisma migrate)
// Prisma cannot manage pgvector indexes natively.
// Execute this in Neon's SQL editor or via a migration script.
//
// 1. Vector similarity index (makes 0.85 threshold query fast):
//
//   CREATE INDEX idx_nodal_tasks_embedding
//   ON nodal_tasks
//   USING ivfflat (embedding vector_cosine_ops)
//   WITH (lists = 100);
//
// 2. Ambiguous assignment detection query (for HITL triggers):
//    Find all SourceEvents linked to 2+ ACTIVE tasks with score spread < 0.05
//    Excludes soft-deleted (dismissed) links from consideration.
//
//   SELECT tsl.event_id,
//          array_agg(tsl.task_id) AS ambiguous_tasks,
//          max(tsl.relevance_score) - min(tsl.relevance_score) AS spread
//   FROM task_source_links tsl
//   WHERE tsl.human_verified = false
//     AND tsl.dismissed = false
//   GROUP BY tsl.event_id
//   HAVING count(*) > 1
//      AND max(tsl.relevance_score) - min(tsl.relevance_score) < 0.05;
//
// =============================================================
